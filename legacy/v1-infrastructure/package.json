    "db:seed:golden": "tsx scripts/seed.ts golden",
    "worker": "tsx scripts/worker.ts",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:db": "tsx --test --test-concurrency=1 tests/db/*.test.ts",
    "test:e2e": "playwright test"
  },
