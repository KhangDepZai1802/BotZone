    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@tailwindcss/postcss": "4.3.5",
    "better-auth": "1.7.22",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "18.0.10",
    "drizzle-orm": "0.45.4",
    "exceljs": "4.4.0",
    "gsap": "3.15.1",
