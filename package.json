{
    "name": "botzone",
    "version": "1.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "next dev --hostname 127.0.0.1",
        "build": "next build",
        "postbuild": "node --input-type=module -e \"import { cpSync } from 'node:fs'; cpSync('public','.next/standalone/public',{recursive:true}); cpSync('.next/static','.next/standalone/.next/static',{recursive:true});\"",
        "start": "node .next/standalone/server.js",
        "typecheck": "tsc --noEmit",
        "test:e2e": "node tests/web/storefront-smoke.mjs",
        "test": "tsx --test tests/unit/*.test.ts"
    },
    "dependencies": {
        "@hookform/resolvers": "7.0.6",
        "@radix-ui/react-dialog": "1.3.1",
        "@radix-ui/react-select": "2.4.1",
        "@radix-ui/react-slot": "1.5.0",
        "@react-three/drei": "10.7.9",
        "@react-three/fiber": "9.8.2",
        "@tailwindcss/postcss": "4.3.5",
        "class-variance-authority": "0.7.1",
        "clsx": "2.1.1",
        "gsap": "3.15.1",
        "lucide-react": "1.72.0",
        "next": "16.4.6",
        "next-intl": "4.15.1",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-hook-form": "7.92.0",
        "tailwind-merge": "3.7.0",
        "tailwindcss": "4.3.5",
        "three": "0.187.0",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@playwright/test": "1.65.0",
        "@types/node": "26.6.6",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@types/three": "0.187.0",
        "tsx": "4.23.15",
        "typescript": "7.0.2"
    }
}
